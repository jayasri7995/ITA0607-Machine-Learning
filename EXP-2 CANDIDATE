import pandas as pd
import io

# Load dataset
csv_data = """Sky,AirTemp,Humidity,Wind,Water,Forecast,EnjoySport
Sunny,Warm,Normal,Strong,Warm,Same,Yes
Sunny,Warm,High,Strong,Warm,Same,Yes
Rainy,Cold,High,Strong,Warm,Change,No
Sunny,Warm,High,Strong,Cool,Change,Yes
Sunny,Warm,Normal,Weak,Warm,Same,Yes
Rainy,Warm,Normal,Weak,Warm,Same,No
Cloudy,Cold,High,Strong,Cool,Change,No
Sunny,Warm,High,Weak,Warm,Same,Yes"""
data = pd.read_csv(io.StringIO(csv_data))

print("Training Dataset:\n")
print(data)

# Features and Target
concepts = data.iloc[:, :-1].values.tolist()
target = data.iloc[:, -1].tolist()

# Initialize Specific Hypothesis
S = concepts[0][:]

# Initialize General Hypothesis
G = [["?" for _ in range(len(S))]]

print("\nInitial Specific Hypothesis:")
print(S)

print("\nInitial General Hypothesis:")
print(G)

# Candidate Elimination Algorithm
for i, h in enumerate(concepts):

    if target[i] == "Yes":

        # Update Specific Hypothesis
        for x in range(len(S)):
            if h[x] != S[x]:
                S[x] = "?"

        # Remove inconsistent hypotheses from G
        G = [g for g in G if all(g[j] == "?" or g[j] == S[j] for j in range(len(S)))]

    else:

        # Specialize General Hypothesis
        new_G = []

        for g in G:
            for x in range(len(S)):

                if g[x] == "?":

                    if S[x] != "?":
                        new_h = g.copy()
                        new_h[x] = S[x]
                        new_G.append(new_h)

        G = new_G

    print("\nAfter Training Example", i + 1)
    print("Specific Hypothesis:")
    print(S)
    print("General Hypothesis:")
    print(G)

print("\n===============================")
print("Final Specific Hypothesis (S):")
print(S)

print("\nFinal General Hypothesis (G):")
for g in G:
    print(g)

